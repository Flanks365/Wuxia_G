# =====================================================================
#  Unreal Engine .gitignore  (lecture18552)
#  Goal: only commit what the project actually needs, so LFS stays small.
#  Commit: Source/, Config/, Content/ (.uasset/.umap), the .uproject
# =====================================================================

# ---------------------------------------------------------------------
# Engine-generated folders (rebuilt automatically, often GBs)
# ---------------------------------------------------------------------
Binaries/
Intermediate/
Saved/
DerivedDataCache/
Build/*
!Build/*/
Build/*/**
!Build/*/PakBlacklist*.txt
!Build/**/*.ico

# Same folders inside plugins
Plugins/**/Binaries/
Plugins/**/Intermediate/
Plugins/**/Saved/

# Lighting / HLOD build output - regenerated by "Build" in the editor
*_BuiltData.uasset

# ---------------------------------------------------------------------
# IDE / editor user files (personal settings, not shared)
# ---------------------------------------------------------------------
.vs/
.vscode/
.idea/
*.DotSettings.user
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb
*.xcodeproj
*.xcworkspace

# ---------------------------------------------------------------------
# OS junk
# ---------------------------------------------------------------------
.DS_Store
._*
Thumbs.db
desktop.ini

# ---------------------------------------------------------------------
# Compiled output
# ---------------------------------------------------------------------
*.slo
*.lo
*.o
*.obj
*.gch
*.pch
*.so
*.dylib
*.dll
*.mod
*.lai
*.la
*.a
*.lib
*.exe
*.out
*.app
*.ipa
*.pdb
*.tmp
*.bak

# ---------------------------------------------------------------------
# Raw source art inside Content/
# Once imported, Unreal stores everything in the .uasset - the original
# .fbx/.png/.wav sitting next to it is a duplicate that would go to LFS.
# Keep originals outside Content/ (e.g. a SourceArt/ folder) if you need them.
# ---------------------------------------------------------------------
Content/**/*.[fF][bB][xX]
Content/**/*.[oO][bB][jJ]
Content/**/*.[bB][lL][eE][nN][dD]
Content/**/*.[bB][lL][eE][nN][dD]1
Content/**/*.[pP][nN][gG]
Content/**/*.[tT][gG][aA]
Content/**/*.[jJ][pP][gG]
Content/**/*.[jJ][pP][eE][gG]
Content/**/*.[pP][sS][dD]
Content/**/*.[eE][xX][rR]
Content/**/*.[hH][dD][rR]
Content/**/*.[wW][aA][vV]
Content/**/*.[mM][pP]3
Content/**/*.[oO][gG][gG]
Content/**/metadata

SourceArt/**/*.png
SourceArt/**/*.tga

# ---------------------------------------------------------------------
# Content that doesn't need to be shared
# ---------------------------------------------------------------------
# Per-user test folders created by the editor
Content/Developers/

# LPRiverForest's three showcase levels (~220 MB, half the repo's LFS).
# The forest meshes/materials are still committed - only the demo maps are skipped.
# Delete these lines if your game actually uses one of these maps.
Content/LPRiverForest/Maps/LPRiverForest_Demo.umap
Content/LPRiverForest/Maps/LPRiverForest_DemoAutumn.umap
Content/LPRiverForest/Maps/LPRiverForest_DemoSnow.umap
